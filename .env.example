# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=8083
LOG_LEVEL=info
# Include customer message text in decision logs (off by default: it is personal data).
LOG_CUSTOMER_TEXT=false
DATABASE_PATH=./data/support.db
KNOWLEDGE_DIR=./knowledge
PROMPTS_DIR=./prompts

# LLM provider: "fake" is deterministic and offline; "anthropic" calls the Claude API.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
# USD per million tokens, used only for the estimated_cost_usd field. Set them from your
# provider's current price list; 0 means "not tracked".
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_MS=15000
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_MS=500
LLM_RETRY_MAX_DELAY_MS=4000

# Prompt files in prompts/<version>.md; the version id is stored with every decision.
CLASSIFY_PROMPT_VERSION=classify.v1
ANSWER_PROMPT_VERSION=answer.v1

# Policy thresholds
MIN_CLASSIFIER_CONFIDENCE=0.6
MIN_ANSWER_CONFIDENCE=0.7
RETRIEVAL_MIN_SCORE=2.5
RETRIEVAL_TOP_K=3
# Approximate tokens (characters / 4) of earlier conversation sent to the model.
HISTORY_TOKEN_BUDGET=1500
REPLY_MIN_CHARS=2
REPLY_MAX_CHARS=700

# Rate limits (in-memory, per process)
RATE_LIMIT_PER_KEY_PER_MINUTE=120
RATE_LIMIT_PER_CUSTOMER_PER_MINUTE=12
